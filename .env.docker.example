# Consologist TMS — Docker stack environment.
# Copy to .env.docker (gitignored) and fill in real values.
# Compose interpolation reads this file with:
#   docker compose --env-file .env.docker up -d --build

# ---- Postgres (immutable after the first start on a non-empty volume) ----
POSTGRES_USER=consologist
POSTGRES_PASSWORD=
POSTGRES_DB=consologist_tms

# ---- App ----
APP_URL=https://tms.consologist.com
JWT_SECRET=
CRON_SECRET=
BACKUP_SCHEDULE_PASSWORD=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@consologist.com

# ---- Google login (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Google Drive file storage (optional; required for file uploads) ----
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_ENCRYPTION_KEY=
# Must match the redirect URI registered in Google Cloud Console.
GOOGLE_DRIVE_REDIRECT_URI=https://tms.consologist.com/api/google-drive/callback

# ---- stdio MCP (only if you run the MCP subprocess outside Docker) ----
# HTTP MCP is served by the app at /api/mcp and needs no extra env.
MCP_API_KEY=
MCP_COMPANY_ID=
