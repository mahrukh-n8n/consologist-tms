# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/freedcamp

# Auth session (openssl rand -hex 32)
JWT_SECRET=

# Email (auth-session)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Google login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Google Drive (files)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback
GOOGLE_DRIVE_ENCRYPTION_KEY=

# Due-alert cron (Bearer / x-cron-secret)
CRON_SECRET=

# Scheduled backups encryption password (>= 8 chars)
BACKUP_SCHEDULE_PASSWORD=

# MCP stdio subprocess
MCP_API_KEY=
MCP_COMPANY_ID=
